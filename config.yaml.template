server:
  host: "127.0.0.1"
  port: 8765

providers:
  zai:
    base_url: "https://api.z.ai/api/anthropic"
    api_key: "your-zai-api-key"
  minimax:
    base_url: "https://api.minimaxi.com/anthropic"
    api_key: "your-minimax-api-key"

claude_settings:
  default_opus_model: "claude-opus-4-7"
  default_sonnet_model: "claude-sonnet-4-6"
  default_haiku_model: "claude-haiku-4-5"
  api_timeout_ms: 3000000

# Infisical 密钥同步（可选）：启用后可用 `flexgate sync` 从 Infisical 拉取 provider 的 api_key。
# 每个 provider 是 /providers 下与其同名的文件夹，内含 API_KEY secret
# （如 /providers/minimax-tmy/API_KEY），文件夹名即 provider 映射，名符其实、无损。
# 可选 MODELS secret 存放逗号分隔的模型名。config 中不存在的新文件夹会按名字前缀
# 匹配已知 base_url 自动导入（前缀注册表见 flexgate/registry.py），识别不了的前缀会报警告。
# infisical:
#   project_id: "your-infisical-project-id"
#   env: "dev"

# 定时路由（可选）：按时间自动切换模型配置，首个时间窗口命中生效
# schedule:
#   - name: "xiaomi-discount"
#     start: "16:00"
#     end: "24:00"
#     routes:
#       - pattern: "^claude-opus"
#         provider: zai
#         model: "glm-5.1"
#       - pattern: "^claude-sonnet"
#         provider: xiaomi
#         model: "mimo-v2.5-pro"
#       - pattern: "^claude-haiku"
#         provider: minimax
#         model: "MiniMax-M3"

# 默认路由（不在任何定时窗口内时使用）
routes:
  - pattern: "^claude-opus"
    provider: zai
    model: "glm-5.1"
  - pattern: "^claude-sonnet"
    provider: minimax
    model: "MiniMax-M3"
  - pattern: "^claude-haiku"
    provider: minimax
    model: "MiniMax-M3"
  - pattern: ".*"
    provider: minimax
    model: "MiniMax-M3"
